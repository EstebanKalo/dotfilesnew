[global]
    monitor = 0
    follow = mouse
    width = 300
    height = (0, 300)
    offset = (10, 10)
    scale = 0
    origin = bottom-right
    transparency = 10
    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    frame_width = 2
    frame_color = "#444444"
    separator_height = 2
    separator_color = frame
    font = Monospace 8
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    max_icon_size = 64
    sticky_history = yes
    history_length = 20
    dmenu = dmenu -p dunst:
    browser = firefox -new-tab
    always_run_script = false
    title = Dunst
    class = Dunst
    corner_radius = 6

    # Atajos (migrados desde [shortcuts])
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period

[urgency_low]
    background = "#222222"
    foreground = "#888888"
    timeout = 5

[urgency_normal]
    background = "#285577"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#900000"
    foreground = "#ffffff"
    timeout = 0

